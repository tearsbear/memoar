{
  "manifest_version": 3,
  "name": "Memoar Post Capture",
  "version": "0.1.0",
  "description": "Capture visible data from a post you explicitly choose, then inspect it in local Memoar.",
  "minimum_chrome_version": "112",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_popup": "popup.html", "default_title": "Memoar Post Capture" },
  "background": { "service_worker": "background.js" },
  "externally_connectable": { "matches": ["http://localhost/*"] },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
