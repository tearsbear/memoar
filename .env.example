# Optional display-only prototype switch.
# Set false to skip official display requests and keep URL-only inspections.
MEMOAR_EMBEDS_ENABLED=true

# Muse Spark enrichment. Set these on Vercel too; never use NEXT_PUBLIC_ for secrets.
MODEL_API_KEY=
# Server-only signing secret, at least 24 characters. The dashboard pairs
# the extension automatically; never bundle this value or the Meta API key.
MEMOAR_ENRICHMENT_TOKEN=
# Optional public extension identifier (not a credential). The popup normally supplies it.
NEXT_PUBLIC_MEMOAR_EXTENSION_ID=

# Hosted media transit only: connect a PRIVATE Vercel Blob store.
# Keep its read-write token server-side; the extension gets restricted upload tokens.
BLOB_READ_WRITE_TOKEN=
# Random server-only secret for Vercel's daily orphan-file cleanup cron.
CRON_SECRET=
